# Copiar este archivo como ".env". Para la demo sirve tal cual; en un servidor real
# hay que reemplazar las dos claves. El archivo .env no se sube al repositorio.

POSTGRES_USER=rondas
POSTGRES_PASSWORD=reemplazar-por-una-clave-larga
POSTGRES_DB=rondas

# Clave que firma la cookie de sesión. Se puede generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=reemplazar-por-una-clave-aleatoria
